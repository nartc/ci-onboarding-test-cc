{
  "name": "@ci/config",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.lib.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "clean": "rm -rf dist",
    "env-check": "node scripts/env-check.mjs"
  },
  "nx": {
    "tags": [
      "type:lib",
      "scope:shared"
    ],
    "targets": {
      "env-check": {
        "cache": false
      }
    }
  },
  "dependencies": {
    "@ci/constants": "workspace:*",
    "@ci/logger": "workspace:*",
    "@ci/utils": "workspace:*",
    "@ci/validation": "workspace:*"
  }
}
