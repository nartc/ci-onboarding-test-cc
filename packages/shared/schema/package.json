{
  "name": "@ci/schema",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "codegen": "node scripts/codegen.mjs",
    "build": "tsc -p tsconfig.lib.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "clean": "rm -rf dist src/generated"
  },
  "nx": {
    "tags": [
      "type:lib",
      "scope:shared"
    ],
    "targets": {
      "build": {
        "dependsOn": [
          "codegen",
          "^build"
        ]
      },
      "typecheck": {
        "dependsOn": [
          "codegen",
          "^build"
        ]
      },
      "test": {
        "dependsOn": [
          "codegen",
          "^build"
        ]
      }
    }
  },
  "dependencies": {
    "@ci/serializer": "workspace:*",
    "@ci/utils": "workspace:*",
    "@ci/validation": "workspace:*"
  }
}
