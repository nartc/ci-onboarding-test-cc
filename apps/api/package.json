{
  "name": "@ci/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/app.d.ts",
      "default": "./dist/app.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.lib.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "serve": "PORT=4310 node dist/main.js",
    "start": "node dist/main.js",
    "clean": "rm -rf dist"
  },
  "nx": {
    "tags": [
      "type:app"
    ],
    "targets": {
      "serve": {
        "continuous": true,
        "dependsOn": [
          "build"
        ]
      }
    }
  },
  "dependencies": {
    "@ci/audit": "workspace:*",
    "@ci/auth": "workspace:*",
    "@ci/billing": "workspace:*",
    "@ci/config": "workspace:*",
    "@ci/feature-flags": "workspace:*",
    "@ci/http": "workspace:*",
    "@ci/inventory": "workspace:*",
    "@ci/metrics": "workspace:*",
    "@ci/notifications": "workspace:*",
    "@ci/orders": "workspace:*",
    "@ci/payments": "workspace:*",
    "@ci/recommendations": "workspace:*",
    "@ci/search": "workspace:*",
    "@ci/shipping": "workspace:*",
    "@ci/tracing": "workspace:*",
    "@ci/users": "workspace:*",
    "@ci/utils": "workspace:*"
  }
}
