{
  "name": "@ci/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/app.d.ts",
      "default": "./dist/app.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.lib.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "serve": "PORT=4320 node dist/serve.js",
    "start": "node dist/main.js",
    "clean": "rm -rf dist"
  },
  "nx": {
    "tags": [
      "type:app"
    ],
    "targets": {
      "serve": {
        "continuous": true,
        "dependsOn": [
          "build"
        ]
      }
    }
  },
  "dependencies": {
    "@ci/i18n": "workspace:*",
    "@ci/sdk": "workspace:*",
    "@ci/ui-components": "workspace:*",
    "@ci/ui-forms": "workspace:*",
    "@ci/ui-layout": "workspace:*",
    "@ci/utils": "workspace:*"
  }
}
