{
  "name": "@ci/api-e2e",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "e2e": "vitest run",
    "clean": "rm -rf dist"
  },
  "nx": {
    "tags": [
      "type:e2e"
    ],
    "targets": {
      "e2e": {
        "dependsOn": [
          "^build",
          {
            "projects": [
              "@ci/api"
            ],
            "target": "serve"
          }
        ]
      }
    }
  },
  "devDependencies": {
    "@ci/api": "workspace:*",
    "@ci/sdk-mocks": "workspace:*"
  }
}
