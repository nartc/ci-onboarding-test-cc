{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "nxCloudId": "6af603847747f26820f2f69d",
  "namedInputs": {
    "sharedGlobals": [
      "{workspaceRoot}/tsconfig.base.json",
      "{workspaceRoot}/.nvmrc",
      "{workspaceRoot}/pnpm-lock.yaml",
      { "env": "CI_LAB_CACHE_SALT" }
    ],
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "production": [
      "default",
      "!{projectRoot}/**/*.test.ts",
      "!{projectRoot}/vitest.config.ts",
      "!{projectRoot}/tsconfig.json"
    ]
  },
  "targetDefaults": {
    "codegen": {
      "cache": true,
      "inputs": [
        "{projectRoot}/schemas/**/*",
        "{projectRoot}/scripts/codegen.mjs",
        { "env": "CI_LAB_CACHE_SALT" }
      ],
      "outputs": ["{projectRoot}/src/generated"]
    },
    "build": {
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": ["production", "^production"],
      "outputs": ["{projectRoot}/dist"]
    },
    "typecheck": {
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": ["default", "^production"]
    },
    "lint": {
      "cache": true,
      "inputs": ["default", "{workspaceRoot}/eslint.config.js"]
    },
    "test": {
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": [
        "default",
        "^production",
        { "env": "CI_LAB_CPU_SECONDS" },
        { "env": "CI_LAB_SLOW_SECONDS" },
        { "env": "CI_LAB_MEM_MB" }
      ]
    },
    "e2e": {
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": ["default", "^production"]
    }
  }
}
