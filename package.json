{
  "name": "ci-onboarding-test-cc",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "nx run-many -t build",
    "typecheck": "nx run-many -t typecheck",
    "lint": "nx run-many -t lint",
    "test": "nx run-many -t test",
    "e2e": "nx run-many -t e2e",
    "check": "nx run-many -t lint build typecheck test e2e",
    "affected": "nx affected -t lint typecheck build test e2e",
    "env-check": "nx run @ci/config:env-check",
    "graph": "nx graph",
    "clean": "pnpm -r run clean",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.0.0",
    "eslint": "^10.0.0",
    "globals": "^17.0.0",
    "nx": "24.0.6",
    "prettier": "^3.10.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.1.0"
  }
}
